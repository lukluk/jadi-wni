# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: ${ORIGIN}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL publik aplikasi (wajib di production untuk adapter-node & redirect OAuth)
ORIGIN=http://localhost:5173

# Lokasi database SQLite
DB_PATH=./data/app.db

# true = tampilkan "Masuk sebagai tamu" (untuk testing lokal tanpa Google). JANGAN aktifkan di production.
ALLOW_DEV_LOGIN=true
